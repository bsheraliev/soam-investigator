 "occurrence": {
  "id": "case-hamilton-2015",
  "title": {
   "en": "Loss of Separation at Hamilton, NZ, December 2015",
   "ru": "Нарушение интервалов эшелонирования, Гамильтон, Новая Зеландия, декабрь 2015"
  },
  "date": "2015-12",
  "place": "Hamilton, New Zealand",
  "type": "incident",
  "severity": null,
  "investigate": true,
  "status": "analysis",
  "outcome": [
   "Loss of separation safety occurrence",
   "Potential mid-air collision",
   "No injuries or damage"
  ],
  "isTestCase": true
 },
 "facts": [
  {
   "id": "case-hamilton-2015:f-other-01",
   "occurrenceId": "case-hamilton-2015",
   "text": "Regulatory surveillance of Airways NZ operations did not identify the increased safety risks at Hamilton",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-osf-01",
   "occurrenceId": "case-hamilton-2015",
   "text": "Teamwork and professional standards (TRM) training had not been completed by any Hamilton controllers",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-osf-02",
   "occurrenceId": "case-hamilton-2015",
   "text": "Redesign of airspace around Hamilton and the traffic density and complexity created a hazard in uncontrolled airspace",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-osf-03",
   "occurrenceId": "case-hamilton-2015",
   "text": "Hamilton is not a popular posting, as employment conditions are the same as other locations involving lower & more varied workload",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-osf-04",
   "occurrenceId": "case-hamilton-2015",
   "text": "Airways NZ had no formal strategy or processes for staff retention at unpopular locations",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-osf-05",
   "occurrenceId": "case-hamilton-2015",
   "text": "Airways NZ traditionally posted recently qualified controllers with limited experience to Hamilton",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-osf-06",
   "occurrenceId": "case-hamilton-2015",
   "text": "Airways NZ had no policy or processes to ensure a blend of controller seniority or experience at complex workplaces",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-osf-07",
   "occurrenceId": "case-hamilton-2015",
   "text": "Airways NZ had not identified the increased risks associated with the blend of complex traffic and low controller experience at Hamilton",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-01",
   "occurrenceId": "case-hamilton-2015",
   "text": "The controller was anxious about his annual proficiency assessment",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-02",
   "occurrenceId": "case-hamilton-2015",
   "text": "Hamilton aerodrome is one of the busiest in NZ with the highest number of VFR movements in NZ",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-03",
   "occurrenceId": "case-hamilton-2015",
   "text": "The controller became overwhelmed and lost SA",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-04",
   "occurrenceId": "case-hamilton-2015",
   "text": "The high number of trainee pilots at Hamilton intensified controller workload",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-05",
   "occurrenceId": "case-hamilton-2015",
   "text": "Many pilot trainees do not have English as first language",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-06",
   "occurrenceId": "case-hamilton-2015",
   "text": "Staff turnover was high, with short tenure and many inexperienced controllers",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-07",
   "occurrenceId": "case-hamilton-2015",
   "text": "The assessor arrived just before the shift started",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-08",
   "occurrenceId": "case-hamilton-2015",
   "text": "The assessor did not conduct a standard pre-assessment briefing, \"set the scene\" or discuss teamwork expectations",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-09",
   "occurrenceId": "case-hamilton-2015",
   "text": "The standard of TRM in Hamilton Tower was below industry good practice",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-10",
   "occurrenceId": "case-hamilton-2015",
   "text": "There was a breakdown in effective teamwork",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-11",
   "occurrenceId": "case-hamilton-2015",
   "text": "Some controllers were \"over-controlling\" VFR traffic",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-cc-12",
   "occurrenceId": "case-hamilton-2015",
   "text": "Cultural factors led to high student pilot compliance (Power Distance)",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-hi-01",
   "occurrenceId": "case-hamilton-2015",
   "text": "The controller did not effectively manage the number of aircraft within the circuit",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-hi-02",
   "occurrenceId": "case-hamilton-2015",
   "text": "Standard protocol to provide a clear space around first solo pilots was not followed",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-hi-03",
   "occurrenceId": "case-hamilton-2015",
   "text": "Non-standard instructions were given to a pilot on their first solo flight",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-bar-01",
   "occurrenceId": "case-hamilton-2015",
   "text": "A standard pre-assessment briefing was not conducted",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-bar-02",
   "occurrenceId": "case-hamilton-2015",
   "text": "Effective teamwork & communication (TRM) between controllers",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-bar-03",
   "occurrenceId": "case-hamilton-2015",
   "text": "Standard phraseology & steady pace of delivery",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-bar-04",
   "occurrenceId": "case-hamilton-2015",
   "text": "Standard instructions to first solo pilots",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-hamilton-2015:f-bar-05",
   "occurrenceId": "case-hamilton-2015",
   "text": "Cultural awareness of issues faced by foreign students",
   "shelo": null,
   "source": "SOAM QRG V3, p.49",
   "attachments": [],
   "contributes": true
  }
 ],
