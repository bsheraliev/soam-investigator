 "occurrence": {
  "id": "case-bangkok-1999",
  "title": {
   "en": "Boeing 747-438 Runway Excursion, Bangkok, Thailand, September 1999",
   "ru": "Boeing 747-438 — выкатывание за пределы ВПП, Бангкок, Таиланд, сентябрь 1999"
  },
  "date": "1999-09",
  "place": "Bangkok, Thailand",
  "type": "accident",
  "severity": null,
  "investigate": true,
  "status": "analysis",
  "outcome": [
   "Aircraft overran runway after landing long",
   "No serious injuries (391 pax, 19 crew)",
   "Potential for more serious outcome",
   "Aircraft repair cost: $100,000,000 (?)",
   "Potential damage to company reputation"
  ],
  "isTestCase": true
 },
 "facts": [
  {
   "id": "case-bangkok-1999:f-other-01",
   "occurrenceId": "case-bangkok-1999",
   "text": "Regulations covering contaminated runway operations were unclear",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-other-02",
   "occurrenceId": "case-bangkok-1999",
   "text": "Surveillance of airline flight operations was not thorough",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-other-03",
   "occurrenceId": "case-bangkok-1999",
   "text": "Regulations covering EPs and EP training were not comprehensive",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-01",
   "occurrenceId": "case-bangkok-1999",
   "text": "QF had no appropriately documented information or procedures about operations on water-affected runways",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-02",
   "occurrenceId": "case-bangkok-1999",
   "text": "QF had not distributed \"Landing on Slippery Runways\" (Boeing doc) to crew since 1977",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-03",
   "occurrenceId": "case-bangkok-1999",
   "text": "Contaminated runway issues not covered during crew endorsement, promotional or recurrent training in recent years",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-04",
   "occurrenceId": "case-bangkok-1999",
   "text": "FLTOPS documents were unclear (e.g., key terms not well defined)",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-05",
   "occurrenceId": "case-bangkok-1999",
   "text": "FLTOPS management decisions were informal, 'intuitive' and 'personality-driven'",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-06",
   "occurrenceId": "case-bangkok-1999",
   "text": "No formal risk assessment conducted when changed landing procedure researched",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-07",
   "occurrenceId": "case-bangkok-1999",
   "text": "Implementation of new landing procedure by QF was not systematic",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-08",
   "occurrenceId": "case-bangkok-1999",
   "text": "No formal review of new procedures after 'trial' period",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-09",
   "occurrenceId": "case-bangkok-1999",
   "text": "Cost-benefit analysis of new landing procedure was biased",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-10",
   "occurrenceId": "case-bangkok-1999",
   "text": "QF had no policies or procedures on maintaining flying recency for management pilots",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-osf-11",
   "occurrenceId": "case-bangkok-1999",
   "text": "QF had no policies or procedures on duty or work limits for pilots with flying and non-flying duties",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-01",
   "occurrenceId": "case-bangkok-1999",
   "text": "Very heavy rainfall, runway surface affected by water",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-02",
   "occurrenceId": "case-bangkok-1999",
   "text": "Crew were not aware of the critical importance of reverse thrust as a stopping force on water-affected runways",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-03",
   "occurrenceId": "case-bangkok-1999",
   "text": "Most QF pilots were not fully aware about 'aquaplaning'",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-04",
   "occurrenceId": "case-bangkok-1999",
   "text": "QF B747 fleet generally operated in good weather and to aerodromes with long, good quality runways",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-05",
   "occurrenceId": "case-bangkok-1999",
   "text": "New 1996 landing procedure was inappropriate for use in the existing conditions",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-06",
   "occurrenceId": "case-bangkok-1999",
   "text": "Normal practice to use flaps 25 / idle reverse",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-07",
   "occurrenceId": "case-bangkok-1999",
   "text": "Crew did not have recent experience using full reverse thrust",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-08",
   "occurrenceId": "case-bangkok-1999",
   "text": "Reduced visibility and distraction: Heavy rain and windscreen wipers",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-09",
   "occurrenceId": "case-bangkok-1999",
   "text": "Captain and FO quite low levels of flying in the previous 30 days",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-10",
   "occurrenceId": "case-bangkok-1999",
   "text": "FO had been awake for 19 hours at the time of the accident",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-cc-11",
   "occurrenceId": "case-bangkok-1999",
   "text": "Captain had been awake for 21 hours at the time of the accident",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-hi-01",
   "occurrenceId": "case-bangkok-1999",
   "text": "Flight crew did not use an adequate risk management strategy for the approach and landing",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-hi-02",
   "occurrenceId": "case-bangkok-1999",
   "text": "Crew employed flaps 25 / idle reverse landing configuration",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-hi-03",
   "occurrenceId": "case-bangkok-1999",
   "text": "First Officer did not fly the aircraft accurately during the final approach",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-hi-04",
   "occurrenceId": "case-bangkok-1999",
   "text": "Captain cancelled the go-around by retarding the thrust levers",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-bar-01",
   "occurrenceId": "case-bangkok-1999",
   "text": "Landing procedure was inappropriate for contaminated runways",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-bar-02",
   "occurrenceId": "case-bangkok-1999",
   "text": "Go-around procedure was not followed",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-bar-03",
   "occurrenceId": "case-bangkok-1999",
   "text": "Reverse thrust was not used during landing",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-bar-04",
   "occurrenceId": "case-bangkok-1999",
   "text": "Auto-brake system was disarmed",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  },
  {
   "id": "case-bangkok-1999:f-bar-05",
   "occurrenceId": "case-bangkok-1999",
   "text": "Crew Resource Management issues (risk management; crew communication & coordination)",
   "shelo": null,
   "source": "SOAM QRG V3, p.48",
   "attachments": [],
   "contributes": true
  }
 ],
